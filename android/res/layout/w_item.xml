<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/item"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingTop="9dp" android:paddingBottom="9dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/ala" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/w_ala" android:contentDescription="@null"/>
    <TextView android:id="@+id/fonte" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="6dp"
        android:textColor="@color/w_texto2" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <TextView android:id="@+id/titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp"
      android:textColor="@color/w_texto" android:textSize="14sp" android:maxLines="3" android:ellipsize="end" android:fontFamily="serif"/>
</LinearLayout>
